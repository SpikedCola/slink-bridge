#include <windows.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 244, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Stereo Switch"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "S-Link bridge address:", -1, 8, 8, 228, 10
    EDITTEXT        IDC_HOST, 8, 20, 228, 14, ES_AUTOHSCROLL
    LTEXT           "Host name or IP address, optionally with :port. Default: slink.local. If Windows can't resolve .local names, use the IP address.", -1, 8, 38, 228, 26
    PUSHBUTTON      "Test", IDC_TEST, 8, 74, 44, 14
    LTEXT           "", IDC_RESULT, 58, 77, 80, 10
    DEFPUSHBUTTON   "OK", IDOK, 142, 74, 44, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 192, 74, 44, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Winamp S-Link stereo input switch"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "gen_stereo"
            VALUE "OriginalFilename", "gen_stereo.dll"
            VALUE "ProductName", "slink-bridge"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
